#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
#, markdown-text
msgid ""
"fetching RSS items (new, favorites, unread, by_id, by_feed, by_category, "
"since)"
msgstr ""

#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
#, markdown-text
msgid "fetching favicons"
msgstr ""

#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
#, markdown-text
msgid "setting read marker for item(s)"
msgstr ""

#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
#, markdown-text
msgid "setting starred marker for item(s)"
msgstr ""

#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
#, markdown-text
msgid "setting read marker for feed"
msgstr ""

#. type: Bullet: '* '
#: en/./developers/fever-api.md:53
