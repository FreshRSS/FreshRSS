#. type: Title ###
#: en/./developers/first-steps.md:163
#, markdown-text, no-wrap
msgid "Indentation"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:166
#, markdown-text
msgid "Code indentation must use tabs."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:167
#, markdown-text, no-wrap
msgid "Alignment"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:170
#, markdown-text
msgid ""
"Once the code has been correctly indented, it might be useful to align it "
"for ease of reading. In that case, please use spaces."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:171
#, no-wrap
msgid ""
"$result = a_function_with_a_really_long_name($param1, $param2,\n"
"                                             $param3, $param4);\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:176
#, markdown-text, no-wrap
msgid "End of line"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:179
#, markdown-text
msgid ""
"The newline character must be a line feed (LF), which is the default line "
"ending on *NIX systems. This character must not follow other white space."
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:181
#, markdown-text
msgid ""
"You can verify if there is any unintended white space at the end of line "
"with the following Git command:"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/first-steps.md:182
#, no-wrap
msgid ""
"# command to check files before adding them in the Git index\n"
"git diff --check\n"
"# command to check files after adding them in the Git index\n"
"git diff --check --cached\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:189
#, markdown-text, no-wrap
msgid "End of file"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:192
#, markdown-text
msgid "Every file must end by an empty line."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:193
#, markdown-text, no-wrap
msgid "Commas, dots and semi-columns"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:196
#, markdown-text
msgid ""
"There should no space before those characters, but there should be one "
"after."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:197
#, markdown-text, no-wrap
msgid "Operators"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:200
#, markdown-text
msgid "There should be a space before and after every operator."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:201
#, no-wrap
msgid ""
"if ($a == 10) {\n"
"\t// do something\n"
"}\n"
"\n"
"echo $a ? 1 : 0;\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:209
#, markdown-text, no-wrap
msgid "Parentheses"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:212
#, markdown-text
msgid ""
"There should be no spaces in between brackets. There should be no spaces "
"before the opening bracket, except if it’s after a keyword. There shouldn’t "
"be any spaces after the closing bracket, except if it’s followed by a curly "
"bracket."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:213
#, no-wrap
msgid ""
"if ($a == 10) {\n"
"\t// do something\n"
"}\n"
"\n"
"if ((int)$a == 10) {\n"
"\t// do something\n"
"}\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:223
#, markdown-text, no-wrap
msgid "With chained functions"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:226
#, markdown-text
msgid ""
"It happens most of the time in JavaScript files. When there are chained "
"functions with closures and call-back functions, it’s hard to understand the "
"code if not properly formatted. In those cases, we add a new indent level "
"for the complete instruction and reset the indent for a new instruction on "
"the same level."
msgstr ""

#. type: Fenced code block (javascript)
#: en/./developers/first-steps.md:227
#, no-wrap
msgid ""
"// First instruction\n"
"shortcut.add(shortcuts.mark_read, function () {\n"
"\t\t//...\n"
"\t}, {\n"
"\t\t'disable_in_input': true\n"
"\t});\n"
"// Second instruction\n"
"shortcut.add(\"shift+\" + shortcuts.mark_read, function () {\n"
"\t\t//...\n"
"\t}, {\n"
"\t\t'disable_in_input': true\n"
"\t});\n"
msgstr ""

#. type: Title ##
#: en/./developers/first-steps.md:242
#, markdown-text, no-wrap
msgid "Line length"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:245
#, markdown-text
msgid ""
"Lines should strive to be shorter than 80 characters. However, this limit "
"may be extended to 100 characters when strictly necessary."
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:247
#, markdown-text
msgid "With functions, parameters can be declared on multiple lines."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:248
#, no-wrap
msgid ""
"function my_function($param_1, $param_2,\n"
"                     $param_3, $param_4) {\n"
"\t// do something\n"
"}\n"
msgstr ""

#. type: Title ##
#: en/./developers/first-steps.md:255
#, markdown-text, no-wrap
msgid "Naming"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:258
#, markdown-text
msgid ""
"All code elements (functions, classes, methods and variables) must describe "
"their usage succinctly."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:259
#, markdown-text, no-wrap
msgid "Functions and variables"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:262
#, markdown-text
msgid "Functions and variables must follow the \"snake case\" naming convention."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:263
#, no-wrap
msgid ""
"// a function\n"
"function function_name() {\n"
"\t// do something\n"
"}\n"
"// a variable\n"
"$variable_name;\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:272
#, markdown-text, no-wrap
msgid "Methods"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:275
#, markdown-text
msgid "Methods must follow the \"lower camel case\" naming convention."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:276
#, no-wrap
msgid ""
"private function methodName() {\n"
"\t// do something\n"
"}\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:282
#, markdown-text, no-wrap
msgid "Classes"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:285
#, markdown-text
msgid "Classes must follow the \"upper camel case\" naming convention."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:286
#, no-wrap
msgid "abstract class ClassName {}\n"
msgstr ""

#. type: Title ##
#: en/./developers/first-steps.md:290
#, markdown-text, no-wrap
msgid "Encoding"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:293
#, markdown-text
msgid "Files must be encoded with the UTF-8 character set."
msgstr ""

#. type: Title ##
#: en/./developers/first-steps.md:294
#, markdown-text, no-wrap
msgid "PHP compatibility"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:297
#, markdown-text
msgid ""
"Please ensure that your code works with the oldest PHP version officially "
"supported by FreshRSS."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:298 en/./developers/opml.md:96
#, markdown-text, no-wrap
msgid "Miscellaneous"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:300
#, markdown-text, no-wrap
msgid "Operators on multiple lines"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:303
#, markdown-text
msgid ""
"Operators must be at the end of the line if a condition is split over more "
"than one line."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:304
#, no-wrap
msgid ""
"if ($a == 10 ||\n"
"    $a == 20) {\n"
"\t// do something\n"
"}\n"
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:311
#, markdown-text, no-wrap
msgid "End of PHP file"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:314
#, markdown-text
msgid "If the file contains only PHP code, the PHP closing tag must be omitted."
msgstr ""

#. type: Title ###
#: en/./developers/first-steps.md:315
#, markdown-text, no-wrap
msgid "Arrays"
msgstr ""

#. type: Plain text
#: en/./developers/first-steps.md:318
#, markdown-text
msgid ""
"If an array declaration runs on more than one line, each element must be "
"followed by a comma, including the last one."
msgstr ""

#. type: Fenced code block (php)
#: en/./developers/first-steps.md:319
#, no-wrap
msgid ""
"$variable = [\n"
"\t\"value 1\",\n"
"\t\"value 2\",\n"
"\t\"value 3\",\n"
"];\n"
msgstr ""

