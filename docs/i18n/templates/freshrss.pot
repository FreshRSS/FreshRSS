msgid "[Complete update](#complete-update)"
msgstr ""

#. type: Bullet: '    - '
#: en/./users/refreshing-feeds.md:23
#, markdown-text
msgid "[Partial update](#partial-update)"
msgstr ""

#. type: Bullet: '- '
#: en/./users/refreshing-feeds.md:23
#, markdown-text
