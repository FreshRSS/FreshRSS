#. type: Title ##
#: en/./developers/git-workflow.md:18
#, markdown-text, no-wrap
msgid "Getting the latest code from the FreshRSS repository"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:21
#, markdown-text
msgid "First you need to add the official repo to your remote repo list:"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/git-workflow.md:22
#, no-wrap
msgid "git remote add upstream git@github.com:FreshRSS/FreshRSS.git\n"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:27
#, markdown-text
msgid "You can verify the remote repo is successfully added by using:"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/git-workflow.md:28
#, no-wrap
msgid "git remote -v show\n"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:33
#, markdown-text
msgid "Now you can pull the latest development code:"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/git-workflow.md:34
#, no-wrap
msgid ""
"git checkout edge\n"
"git pull upstream edge\n"
msgstr ""

#. type: Title ##
#: en/./developers/git-workflow.md:39
#, markdown-text, no-wrap
msgid "Starting a new development branch"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/git-workflow.md:41
#, no-wrap
msgid "git checkout -b my-development-branch\n"
msgstr ""

#. type: Title ##
#: en/./developers/git-workflow.md:45
#, markdown-text, no-wrap
msgid "Sending a patch"
msgstr ""

#. type: Fenced code block (sh)
#: en/./developers/git-workflow.md:47
#, no-wrap
msgid ""
"# Add the changed file, here actualize_script.php\n"
"git add app/actualize_script.php\n"
"# Commit the change and write a proper commit message\n"
"git commit\n"
"# Double check all looks well\n"
"git show\n"
"# Push it to your fork\n"
"git push\n"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:59
#, markdown-text
msgid "Now you can create a PR based on your branch."
msgstr ""

#. type: Title ##
#: en/./developers/git-workflow.md:60
#, markdown-text, no-wrap
msgid "How to write a commit message"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:63
#, markdown-text
msgid ""
"A commit message should succinctly describe the changes on the first "
"line. For example:"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:65
#, markdown-text, no-wrap
msgid "> Fix broken icon\n"
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:67
#, markdown-text
msgid "If necessary, this can be followed by a blank line and a longer explanation."
msgstr ""

#. type: Plain text
#: en/./developers/git-workflow.md:68
#, markdown-text
msgid ""
"For further tips, see [here "
"(chris.beams.io)](https://chris.beams.io/posts/git-commit/)."
msgstr ""

