msgid ""
"[Feed configuration of “Do not automatically refresh more often "
"than”](#feed-configuration-of-do-not-automatically-refresh-more-often-than)"
msgstr ""

#. type: Bullet: '    - '
#: en/./users/refreshing-feeds.md:23
#, markdown-text
msgid "[Background](#background)"
msgstr ""

#. type: Bullet: '    - '
#: en/./users/refreshing-feeds.md:23
