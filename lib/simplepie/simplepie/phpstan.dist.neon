parameters:
    phpVersion:
        min: 70400 # PHP 7.4
        max: 80599 # PHP 8.5

    level: 8

    paths:
        - library/
        - src/
        - tests/
        - utils/

    excludePaths:
        analyseAndScan:
            - .git/*?
            - build/*?
            - vendor/*

    # For PHP < 8.4
    ignoreErrors:
        -
            identifier: class.notFound
            messages:
                - '#Dom\\\S+#'

    treatPhpDocTypesAsCertain: false # TODO: Fix

includes:
    - utils/PHPStan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
