# ---- FreshRSS ----
FRESHRSS_URL=https://freshrss.rafaelmaciel.com.br
FRESHRSS_USER=admin
# SENHA DE API (Configurações → Perfil → Gestão da API). NÃO é a senha do painel.
FRESHRSS_API_PASSWORD=trocar

# ---- Rede ----
PORT=8080
# Inclua o hostname público quando publicar pelo túnel:
ALLOWED_HOSTS=localhost,127.0.0.1,mcp-freshrss.rafaelmaciel.com.br

# ---- Acervo visível à equipe ----
# Vazio = todas as categorias. Preencha para restringir.
# Os nomes devem bater EXATAMENTE com os do FreshRSS, emoji incluído.
# Exemplo:
# CATEGORIAS_PERMITIDAS=🔴 Autoridades de Proteção de Dados,🔴 Imprensa Jurídica,🔴 Jurisprudência,🔴 Legislação,🟢 IA e Tecnologia,Direito Digital
CATEGORIAS_PERMITIDAS=

# ---- Limites ----
MAX_ITENS=50
VARREDURA_BUSCA=400

# ---- Autenticação provisória ----
# Use SOMENTE enquanto o Cloudflare Access não estiver ativo.
# Token compartilhado não identifica pessoa nem permite revogação individual.
# Deixe vazio depois de configurar o Access.
MCP_BEARER_TOKEN=
