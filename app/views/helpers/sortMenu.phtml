<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$icon = FreshRSS_Context::$order === 'ASC' ? 'sort-up' : 'sort-down';
	if ($this->internal_rendering) {
		$publicParams = array_filter([
			'a' => Minz_Request::actionName(),
			'search' => Minz_Request::paramString('search', plaintext: true),
			'nb' => Minz_Request::paramInt('nb'),
		], fn($value): bool => $value !== '' && $value !== 0);
		$baseUrl = $this->userQuery->sharedUrlHtml(false);
		$sortUrl = static function (string $sort, ?string $order) use ($baseUrl, $publicParams): string {
			$params = array_merge($publicParams, ['sort' => $sort]);
			if ($order !== null) {
				$params['order'] = $order;
			}
			return htmlspecialchars($baseUrl . '&' . http_build_query($params), ENT_COMPAT, 'UTF-8');
		};
	} else {
		$urlOrder = Minz_Request::currentRequest();
		unset($urlOrder['params']['cid']);
		$sortUrl = static fn(string $sort, ?string $order): string =>
			Minz_Url::display($urlOrder, amend: ['params' => ['sort' => $sort, 'order' => $order]]);
	}
?>
