<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$url = $this->userQuery->sharedUrlHtml() . '&amp;nb=' . FreshRSS_Context::$number;
	$search = FreshRSS_Context::$search->toString();
	if ($search !== '') {
		$url .= '&amp;search=' . rawurlencode($search);
	}
?>
<nav class="nav-pagination nav-list">
	<ul class="pagination">
		<?php if (FreshRSS_Context::$offset > 0): ?>
		<li class="item pager-first">
			<a href="<?= $url ?>">« <?= _t('conf.logs.pagination.first') ?></a>
		</li>
		<li class="item pager-previous">
			<a href="<?= $url . '&amp;offset=' . max(0, FreshRSS_Context::$offset - FreshRSS_Context::$number) ?>">‹ <?= _t('conf.logs.pagination.previous') ?></a>
		</li>
		<?php endif; ?>
		<li class="item pager-next">
			<a href="<?= $url . '&amp;offset=' . (FreshRSS_Context::$offset + FreshRSS_Context::$number) ?>"><?= _t('conf.logs.pagination.next') ?> ›</a>
		</li>
	</ul>
</nav>
