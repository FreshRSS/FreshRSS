<?php
	declare(strict_types=1);
	/** @var View $this */

use FreshRss\Minz\Request;
use FreshRss\Minz\Url;
use FreshRss\Models\Auth;
use FreshRss\Models\Context;
use FreshRss\Models\View;

	$url_next = Request::currentRequest();
	if (Context::$continuation_id !== '0') {
		$url_next['params']['cid'] = Context::$continuation_id;
	}
	if (Context::$sort !== 'id') {
		$url_next['params']['idMax'] = Context::$id_max;
	}
	$url_next['params']['state'] = (string)Context::$state;
	$url_next['params']['ajax'] = '1';

	$url_mark_read = [
		'c' => 'entry',
		'a' => 'read',
		'params' => [
			'get' => Context::currentGet(),
			'nextGet' => Context::$next_get,
			'idMax' => Context::$id_max,
			'search' => Context::$search->toString(),
			'state' => Context::$state,
			'sort' => Context::$sort,
			'order' => Context::$order,
			'from' => Request::paramStringNull('from') ?? Request::actionName(),
		],
	];

	$hasAccess = Auth::hasAccess();
	if ($hasAccess) {
?>
<form id="stream-footer" action="" method="post">
<input type="hidden" name="_csrf" value="<?= Auth::csrfToken() ?>" />
<?php } else { ?>
<div id="stream-footer">
<?php }?>
	<div class="stream-footer-inner">
	<?php if (Context::$continuation_id !== '0') { ?>
		<button id="load_more" type="submit" class="btn" formaction="<?= Url::display($url_next) ?>"><?= _t('gen.stream.load_more') ?></button>
	<?php } elseif ($hasAccess) { ?>
		<?= _t('gen.stream.nothing_to_load') ?>
		<?php if (Context::userConf()->mark_read_button !== 'none') {
			$css = '';
			switch (Context::userConf()->mark_read_button) {
				case 'big':
					$css = 'as-link big';
					break;
				case 'small':
					$css = 'btn small';
					break;
			}
			?>
			<br />
			<button id="bigMarkAsRead"
				class="<?= $css ?> <?= Context::userConf()->reading_confirm ? 'confirm" disabled="disabled' : '' ?>"
				form="stream-footer"
				formaction="<?= Url::display($url_mark_read) ?>"
				type="submit">
				<span class="bigTick">✓</span><br />
				<span class="markAllRead"><?= _t('gen.stream.mark_all_read') ?></span><br />
				<?php if (Context::userConf()->onread_jump_next) { ?>
					<span class="jumpNext"><?= _t('conf.reading.jump_next') ?></span>
				<?php } ?>
			</button>
		<?php
		} } else { ?>
		<?= _t('gen.stream.nothing_to_load') ?><br />
	<?php } ?>
	</div>
<?php if ($hasAccess) { ?>
</form>
<?php } else {?>
</div>
<?php }?>
