<?php
declare(strict_types=1);
/** @var View $this */

use FreshRss\Minz\Request;
use FreshRss\Minz\Url;
use FreshRss\Models\View;

header('Content-Type: application/json; charset=UTF-8');

$url = [
	'c' => Request::controllerName(),
	'a' => Request::actionName(),
	'params' => array_filter($_GET, 'is_string', ARRAY_FILTER_USE_KEY),
];

$url['params']['is_favorite'] = (Request::paramTernary('is_favorite') ?? true) ? '0' : '1';

FreshRSS::loadStylesAndScripts();
echo json_encode([
	'url' => str_ireplace('&amp;', '&', Url::display($url)),
	'icon' => _i($url['params']['is_favorite'] === '1' ? 'non-starred' : 'starred')
]);
