<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	// Override some layout preferences for the public API output
	FreshRSS_Context::userConf()->content_width = 'large';
	FreshRSS_Context::userConf()->show_article_icons = 'a';	// With authors, due to no topline in public view
	FreshRSS_Context::userConf()->show_author_date = FreshRSS_UserConfiguration::default()->show_author_date;
	FreshRSS_Context::userConf()->show_favicons = FreshRSS_UserConfiguration::default()->show_favicons;
	FreshRSS_Context::userConf()->show_feed_name = 'a';	// With authors, due to no topline in public view
	FreshRSS_Context::userConf()->show_tags = FreshRSS_UserConfiguration::default()->show_tags;
	FreshRSS_Context::userConf()->show_tags_max = FreshRSS_UserConfiguration::default()->show_tags_max;
	// User labels are published only if the owner enabled them for this shared query
	FreshRSS_Context::userConf()->topline_myLabels = $this->includeUserLabels && FreshRSS_Context::userConf()->topline_myLabels;
	FreshRSS_Context::userConf()->bottomline_myLabels = $this->includeUserLabels && FreshRSS_Context::userConf()->bottomline_myLabels;
	FreshRSS_Context::userConf()->topline_sharing = false;
	$viewMode = Minz_Request::actionName();
	$viewParams = array_filter([
		'search' => Minz_Request::paramString('search', plaintext: true),
		'nb' => Minz_Request::paramInt('nb'),
		'offset' => Minz_Request::paramInt('offset'),
		'sort' => FreshRSS_Context::$sort,
		'order' => FreshRSS_Context::$sort === 'rand' ? '' : FreshRSS_Context::$order,
	], fn($value): bool => $value !== '' && $value !== 0);
	$baseUrl = $this->userQuery->sharedUrlHtml(false);
	$viewUrl = static fn(string $mode): string => htmlspecialchars(
		$baseUrl . '&' . http_build_query(array_merge($viewParams, ['a' => $mode])),
		ENT_COMPAT,
		'UTF-8',
	);
?>
<?php if ($this->includeUserLabels) {
	$this->renderHelper('index/labelsTemplates');
} ?>
<nav class="nav_menu">
	<div id="nav_menu_views" class="group">
		<a class="view-normal btn <?= $viewMode === 'normal' ? 'active' : '' ?>" title="<?= _t('index.menu.normal_view') ?>" href="<?= $viewUrl('normal') ?>">
			<?= _i('view-normal') ?>
		</a>
		<a class="view-reader btn <?= $viewMode === 'reader' ? 'active' : '' ?>" title="<?= _t('index.menu.reader_view') ?>" href="<?= $viewUrl('reader') ?>">
			<?= _i('view-reader') ?>
		</a>
	</div>
	<?php $this->renderHelper('sortMenu'); ?>
</nav>
<?php $this->renderHelper('htmlPagination'); ?>
<main id="stream" class="<?= $viewMode ?> api<?= $viewMode === 'normal' ? ' hide_posts' : '' ?>">
	<h2>
		<a href="<?= $this->html_url ?>"><?= FreshRSS_View::title() ?></a> ·
		<a class="view-rss" href="<?= $this->rss_url ?>" title="<?= _t('index.menu.rss_view') ?>">
			<?= _i('rss') ?>
		</a>
	</h2>
	<?php
		$nbEntries = 0;
		foreach ($this->entries as $entry) {
			$nbEntries++;
			$this->entry = $entry;
			$this->feed = $this->feeds[$entry->feedId()] ??
				FreshRSS_Category::findFeed($this->categories, $entry->feedId()) ??
				FreshRSS_Feed::default();
			$this->renderHelper('index/article');
		}
	?>
	<?php if ($nbEntries === 0) { ?>
		<div class="prompt alert alert-warn">
			<h2 class="alert-head"><?= _t('index.feed.empty') ?></h2>
		</div>
	<?php } ?>
</main>
<?php $this->renderHelper('htmlPagination'); ?>
