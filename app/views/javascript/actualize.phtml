<?php
declare(strict_types=1);
/** @var ViewJavascript $this */

use FreshRss\Minz\Url;
use FreshRss\Models\ViewJavascript;

$categories = [];
foreach ($this->categories as $category) {
	$categories[] = [
		'url' => Url::display(['c' => 'category', 'a' => 'refreshOpml', 'params' => ['id' => $category->id(), 'ajax' => '1']], 'php'),
		'title' => $category->name(),
	];
}

$feeds = [];
foreach ($this->feeds as $feed) {
	$feeds[] = [
		'url' => Url::display(['c' => 'feed', 'a' => 'actualize', 'params' => ['id' => $feed->id(), 'ajax' => '1']], 'php'),
		'title' => $feed->name(),
	];
}
echo json_encode([
	'categories' => $categories,
	'feeds' => $feeds,
	'feedback_no_refresh' => _t('feedback.sub.feed.no_refresh'),
	'feedback_actualize' => _t('feedback.sub.actualize'),
]);
