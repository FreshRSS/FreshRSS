<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$this->partial('aside_subscription');

	// When this view is re-shown after feedController::addAction() detected a likely duplicate
	// feed, all the fields below are pre-filled with the values the user just submitted (read
	// straight back from the request), so confirming does not silently drop the chosen category
	// or any advanced option. On a fresh "Add feed" page load, these all read back empty and the
	// hard-coded defaults (e.g. `//title`) are used instead, exactly like before.
	$isDuplicateConfirmation = $this->duplicate_feed !== null;
	/**
	 * @param string $default Value to use for a fresh (non-resubmission) form only.
	 */
	$prefill = static function (string $param, string $default = '') use ($isDuplicateConfirmation): string {
		return $isDuplicateConfirmation ? Minz_Request::paramString($param) : $default;
	};
	$prefillChecked = static function (string $param) use ($isDuplicateConfirmation): bool {
		return $isDuplicateConfirmation && Minz_Request::paramBoolean($param);
	};
	$prefillSelected = static function (string $param) use ($isDuplicateConfirmation): ?string {
		return $isDuplicateConfirmation ? Minz_Request::paramStringNull($param) : null;
	};
	$selectedCatId = Minz_Request::paramInt('category') ?: (Minz_Request::paramInt('cat_id') ?: 1);
	$selectedFeedKind = $isDuplicateConfirmation ? Minz_Request::paramInt('feed_kind') : FreshRSS_Feed::KIND_RSS;
?>
