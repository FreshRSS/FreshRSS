{
	"name": "freshrss",
	"type": "module",
	"description": "A free, self-hostable aggregator",
	"homepage": "https://freshrss.org/",
	"readmeFilename": "README.md",
	"bugs": {
		"url": "https://github.com/FreshRSS/FreshRSS/issues"
	},
	"keywords": [
		"news",
		"aggregator",
		"RSS",
		"Atom",
		"WebSub"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FreshRSS/FreshRSS.git"
	},
	"license": "AGPL-3.0",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"eslint": "eslint .",
		"eslint_fix": "eslint --fix .",
		"markdownlint": "markdownlint '**/*.md'",
		"markdownlint_fix": "markdownlint --fix '**/*.md'",
		"rtlcss": "npm run rtlcss:run && npm run rtlcss:clean && npm run rtlcss:imports",
		"rtlcss:run": "rtlcss -d p/themes/",
		"rtlcss:clean": "find p/themes/ -type f -name '*.rtl.rtl.css' -delete",
		"rtlcss:imports": "find p/themes -type f -name '*.rtl.css' -print0 | xargs -0 sed -i -E '/\\.rtl\\.css/! s|^(@import \"[^\"]+)(\\.css\";)$|\\1.rtl\\2|'",
		"stylelint": "stylelint '**/*.css'",
		"stylelint_fix": "stylelint --fix '**/*.css'",
		"test": "npm run eslint && npm run stylelint && npm run markdownlint",
		"fix": "npm run rtlcss && npm run stylelint_fix && npm run eslint_fix && npm run markdownlint_fix"
	},
	"devDependencies": {
		"eslint": "^9.39.0",
		"@eslint/js": "^9.20.0",
		"globals": "^16.5.0",
		"markdownlint-cli": "^0.45.0",
		"neostandard": "^0.12.2",
		"rtlcss": "^4.3.0",
		"stylelint": "^16.26.0",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-order": "^7.0.0",
		"@stylistic/stylelint-plugin": "^4.0.0"
	},
	"rtlcssConfig": {}
}
